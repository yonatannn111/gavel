                    <div className="p-3 bg-purple-50 rounded-lg mr-4 flex-shrink-0 group-hover:bg-purple-100 transition-colors">
                      <FileTextIcon className="w-6 h-6 text-purple-600" />
                    </div>
                    <div>
                      <h3 className="text-lg font-bold text-gray-900 mb-1 group-hover:text-[#8B0000] transition-colors">Learning Materials</h3>
                      <p className="text-gray-600 text-sm">Educational resources and worksheets for skill development</p>
                    </div>
                  </div>
                </motion.a>
                
                <motion.a 
                  href="https://www.toastmasters.org/magazine" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="group block p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all hover:border-[#8B0000]/20"
                  whileHover={{ y: -5 }}
                >
                  <div className="flex items-start">
                    <div className="p-3 bg-green-50 rounded-lg mr-4 flex-shrink-0 group-hover:bg-green-100 transition-colors">
                      <BookOpen className="w-6 h-6 text-green-600" />
                    </div>
                    <div>
                      <h3 className="text-lg font-bold text-gray-900 mb-1 group-hover:text-[#8B0000] transition-colors">Magazine</h3>
                      <p className="text-gray-600 text-sm">Read the latest articles and success stories</p>
                    </div>
                  </div>
                </motion.a>
              </div>
              
              <div className="mt-12 text-center">
                <a 
                  href="https://www.toastmasters.org/" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  className="inline-flex items-center text-[#8B0000] font-medium hover:text-[#B91C1C] group"
                >
                  Visit Toastmasters International Website
                  <ArrowRight className="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </motion.div>
          </div>
        </div>
        
        {/* Footer CTA */}
        <div className="bg-gradient-to-r from-[#8B0000] to-[#B91C1C] text-white py-16 mt-24">
          <div className="container mx-auto px-4 text-center">
            <h2 className="text-3xl font-bold mb-4">Ready to take your skills to the next level?</h2>
            <p className="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
              Join SMU Gavel Club and unlock your full potential as a speaker and leader.
            </p>
            <div className="flex flex-col sm:flex-row justify-center gap-4">
              <a 
                href="/join" 
                className="px-8 py-3 bg-white text-[#8B0000] font-medium rounded-lg hover:bg-gray-100 transition-colors"
              >
                Join Our Club
              </a>
              <a 
                href="/contact" 
                className="px-8 py-3 border-2 border-white text-white font-medium rounded-lg hover:bg-white/10 transition-colors"
              >
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

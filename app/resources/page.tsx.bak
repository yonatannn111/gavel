"use client";

import { motion, AnimatePresence } from "framer-motion";
import { 
  FileText as FileTextIcon,
  Video as VideoIcon, 
  BookOpen, 
  Download, 
  ExternalLink, 
  Search, 
  Mic, 
  ChevronRight, 
  Award, 
  Users, 
  Clock, 
  CheckCircle,
  Youtube,
  PlayCircle,
  Trophy,
  FileQuestion,
  BarChart2,
  Calendar,
  Lightbulb,
  Star,
  FileCheck,
  FileVideo,
  File,
  Filter,
  X,
  ChevronDown,
  ArrowRight
} from 'lucide-react';
import { useState, useEffect, useRef } from 'react';

// Animation variants
const fadeInUp = {
  hidden: { opacity: 0, y: 20 },
  visible: { 
    opacity: 1, 
    y: 0,
    transition: {
      duration: 0.5,
      ease: "easeOut"
    }
  }
};

const staggerContainer = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: {
      staggerChildren: 0.1,
      delayChildren: 0.2
    }
  }
};

type Resource = {
  id: string;
  title: string;
  description: string;
  type: 'pdf' | 'video' | 'article' | 'template' | 'guide' | 'worksheet';
  category: 'beginner' | 'speeches' | 'evaluation' | 'leadership' | 'contests' | 'hybrid' | 'tools';
  url: string;
  thumbnail?: string;
  duration?: string;
  pages?: number;
  author: string;
  date: string;
  featured?: boolean;
  level?: 'beginner' | 'intermediate' | 'advanced';
};

const getIconByType = (type: string) => {
  switch (type) {
    case 'video':
      return <PlayCircle className="w-5 h-5 text-[#8B0000]" />;
    case 'pdf':
      return <FileTextIcon className="w-5 h-5 text-[#8B0000]" />;
    case 'article':
      return <BookOpen className="w-5 h-5 text-[#8B0000]" />;
    case 'template':
      return <FileTextIcon className="w-5 h-5 text-[#8B0000]" />;
    case 'guide':
      return <BookOpen className="w-5 h-5 text-[#8B0000]" />;
    case 'worksheet':
      return <FileCheck className="w-5 h-5 text-[#8B0000]" />;
    default:
      return <File className="w-5 h-5 text-[#8B0000]" />;
  }
};

const getCategoryIcon = (category: string) => {
  switch (category) {
    case 'beginner':
      return <Star className="w-4 h-4 mr-1.5" />;
    case 'speeches':
      return <Mic className="w-4 h-4 mr-1.5" />;
    case 'evaluation':
      return <CheckCircle className="w-4 h-4 mr-1.5" />;
    case 'leadership':
      return <Award className="w-4 h-4 mr-1.5" />;
    case 'contests':
      return <Trophy className="w-4 h-4 mr-1.5" />;
    case 'hybrid':
      return <Users className="w-4 h-4 mr-1.5" />;
    case 'tools':
      return <BarChart2 className="w-4 h-4 mr-1.5" />;
    default:
      return <File className="w-4 h-4 mr-1.5" />;
  }
};

const ResourceCard = ({ resource }: { resource: Resource }) => {
  const isVideo = resource.type === 'video';
  const youtubeId = isVideo && resource.url.includes('youtube.com/') 
    ? resource.url.split('v=')[1]?.split('&')[0] 
    : null;
  const thumbnailUrl = youtubeId 
    ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg` 
    : resource.thumbnail || '/placeholder-resource.jpg';
  
  const [formattedDate, setFormattedDate] = useState('');

  useEffect(() => {
    try {
      const date = new Date(resource.date);
      setFormattedDate(date.toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric' 
      }));
    } catch (error) {
      console.error('Error formatting date:', error);
      setFormattedDate('');
    }
  }, [resource.date]);

  return (
    <motion.div
      className="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100 h-full flex flex-col"
      whileHover={{ y: -4 }}
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
    >
      {isVideo && (
        <div className="relative pt-[56.25%] bg-gray-100 overflow-hidden">
          <img 
            src={thumbnailUrl} 
            alt={resource.title}
            className="absolute inset-0 w-full h-full object-cover"
          />
          <a 
            href={resource.url} 
            target="_blank" 
            rel="noopener noreferrer"
            className="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors"
          >
            <div className="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center group-hover:scale-110 transition-transform">
              <PlayCircle className="w-8 h-8 text-[#8B0000]" />
            </div>
          </a>
          {resource.duration && (
            <span className="absolute bottom-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
              {resource.duration}
            </span>
          )}
        </div>
      )}
      
      <div className="p-6">
        <div className="flex items-center justify-between mb-3">
          <div className="flex items-center">
            <div className="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mr-3">
              {getIconByType(resource.type)}
            </div>
            <div>
              <span className="inline-flex items-center text-xs font-medium text-gray-500 mb-1">
                {getCategoryIcon(resource.category)}
                {resource.category.charAt(0).toUpperCase() + resource.category.slice(1)}
              </span>
            </div>
          </div>
          {resource.featured && (
            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
              Featured
            </span>
          )}
        </div>
        
        <h3 className="text-xl font-bold text-gray-900 mb-2 line-clamp-2">
          <a href={resource.url} target="_blank" rel="noopener noreferrer" className="hover:text-[#8B0000] transition-colors">
            {resource.title}
          </a>
        </h3>
        
        <p className="text-gray-600 mb-4 line-clamp-3">{resource.description}</p>
        
        <div className="flex items-center justify-between pt-4 border-t border-gray-100">
          <div className="flex items-center text-sm text-gray-500">
            <span>{resource.author}</span>
            <span className="mx-2">•</span>
            <span>{formattedDate}</span>
          </div>
          <a 
            href={resource.url} 
            target="_blank" 
            rel="noopener noreferrer"
            className="inline-flex items-center text-sm font-medium text-[#8B0000] hover:text-[#B91C1C] group"
          >
            {resource.type === 'video' ? 'Watch Video' : 'View Resource'}
            <ArrowRight className="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </motion.div>
  );
};

